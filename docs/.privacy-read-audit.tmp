    37: LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
    38: AS $$
    39:   SELECT
    40:     CASE
    41:       WHEN _owner = _viewer THEN true
>   42:       WHEN (SELECT profile_visibility FROM public.profiles WHERE id = _owner) = 'private' THEN false
    43:       WHEN (SELECT library_visibility FROM public.profiles WHERE id = _owner) = 'public' THEN true
    44:       WHEN (SELECT library_visibility FROM public.profiles WHERE id = _owner) = 'followers'
    45:         THEN public.is_following(_viewer, _owner)
    46:       ELSE false
    47:     END
    48: $$;
